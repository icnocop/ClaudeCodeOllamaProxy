<Solution>
  <!-- The WinUI app (ClaudeCodeOllamaProxy.UI) only builds for x64/x86/ARM64 (no "Any CPU"), so the
       solution exposes those platforms. The Console/Core projects are Any CPU and map automatically; the
       UI test project is x64-only (it references the WinUI app, which is x64 on this dev machine). -->
  <Configurations>
    <Platform Name="x64" />
    <Platform Name="x86" />
    <Platform Name="ARM64" />
  </Configurations>
  <Folder Name="/Solution Items/">
    <File Path=".gitattributes" />
    <File Path=".gitignore" />
    <File Path="CHANGELOG.md" />
    <File Path="CLAUDE.md" />
    <File Path="DEVELOPMENT.md" />
    <File Path="LICENSE.txt" />
    <File Path="README.md" />
  </Folder>
  <Folder Name="/Solution Items/docs/">
    <File Path="docs/configuration.md" />
    <File Path="docs/effort-levels.md" />
    <File Path="docs/how-it-works.md" />
    <File Path="docs/image-input.md" />
    <File Path="docs/limitations.md" />
    <File Path="docs/logging.md" />
    <File Path="docs/references.md" />
    <File Path="docs/tool-call-bridge.md" />
    <File Path="docs/troubleshooting.md" />
    <File Path="docs/visual-studio-setup.md" />
    <File Path="docs/vscode-setup.md" />
  </Folder>
  <Folder Name="/Solution Items/docs/screenshots/">
    <File Path="docs/screenshots/about-dark.png" />
    <File Path="docs/screenshots/about-light.png" />
    <File Path="docs/screenshots/home-dark.png" />
    <File Path="docs/screenshots/home-light.png" />
    <File Path="docs/screenshots/logs-dark.png" />
    <File Path="docs/screenshots/logs-light.png" />
    <File Path="docs/screenshots/settings-dark.png" />
    <File Path="docs/screenshots/settings-light.png" />
  </Folder>
  <Project Path="ClaudeCodeOllamaProxy.Console/ClaudeCodeOllamaProxy.Console.csproj" />
  <Project Path="ClaudeCodeOllamaProxy.Core/ClaudeCodeOllamaProxy.Core.csproj" />
  <Project Path="ClaudeCodeOllamaProxy.UI/ClaudeCodeOllamaProxy.UI.csproj">
    <Platform Solution="*|ARM64" Project="ARM64" />
    <Platform Solution="*|x64" Project="x64" />
    <Platform Solution="*|x86" Project="x86" />
  </Project>
  <Project Path="ClaudeCodeOllamaProxy.UI.Tests/ClaudeCodeOllamaProxy.UI.Tests.csproj">
    <Platform Project="x64" />
    <Build Solution="*|ARM64" Project="false" />
    <Build Solution="*|x86" Project="false" />
  </Project>
</Solution>
