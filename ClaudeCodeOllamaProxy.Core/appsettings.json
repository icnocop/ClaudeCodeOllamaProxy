{
  "Claude": {
    "WorkingDirectory": "",
    "CliPath": "",
    "MaxTurns": 50,
    "BridgeTerminalTool": true,
    "CliDebug": false,
    "ModelsCacheTtlMinutes": 30,
    "DefaultEffort": "high",
    "SupportedEfforts": [ "low", "medium", "high", "xhigh", "max" ],
    "KnownModels": [
      "claude-fable-5",
      "claude-mythos-5",
      "claude-opus-5",
      "claude-opus-4-8",
      "claude-opus-4-7",
      "claude-opus-4-6",
      "claude-sonnet-5",
      "claude-sonnet-4-6",
      "claude-haiku-4-5"
    ],
    "McpToolTimeoutMs": 600000,
    "MaxMcpOutputTokens": 100000
  },
  "ModelDefaults": {
    "*": { "ContextLength": 200000, "Capabilities": [ "completion", "tools", "vision" ] },
    "opus": { "DisplayName": "Opus", "ContextLength": 1000000, "Capabilities": [ "completion", "tools", "vision" ] },
    "sonnet": { "DisplayName": "Sonnet", "ContextLength": 1000000, "Capabilities": [ "completion", "tools", "vision" ] },
    "haiku": { "DisplayName": "Haiku", "ContextLength": 200000, "SupportsEffort": false, "Capabilities": [ "completion", "tools" ] },
    "fable": { "DisplayName": "Fable", "ContextLength": 1000000, "Capabilities": [ "completion", "tools", "vision" ] },
    "claude-fable-5": { "DisplayName": "Fable 5", "ContextLength": 1000000, "Capabilities": [ "completion", "tools", "vision" ] },
    "claude-mythos-5": { "DisplayName": "Mythos 5", "ContextLength": 1000000, "Capabilities": [ "completion", "tools", "vision" ] },
    "claude-opus-5": { "DisplayName": "Opus 5", "ContextLength": 1000000, "Capabilities": [ "completion", "tools", "vision" ] },
    "claude-opus-4-8": { "DisplayName": "Opus 4.8", "ContextLength": 1000000, "Capabilities": [ "completion", "tools", "vision" ] },
    "claude-opus-4-7": { "DisplayName": "Opus 4.7", "ContextLength": 1000000, "Capabilities": [ "completion", "tools", "vision" ] },
    "claude-opus-4-6": { "DisplayName": "Opus 4.6", "ContextLength": 1000000, "SupportedEfforts": [ "low", "medium", "high", "max" ], "Capabilities": [ "completion", "tools", "vision" ] },
    "claude-sonnet-5": { "DisplayName": "Sonnet 5", "ContextLength": 1000000, "Capabilities": [ "completion", "tools", "vision" ] },
    "claude-sonnet-4-6": { "DisplayName": "Sonnet 4.6", "ContextLength": 1000000, "SupportedEfforts": [ "low", "medium", "high", "max" ], "Capabilities": [ "completion", "tools", "vision" ] },
    "claude-haiku-4-5": { "DisplayName": "Haiku 4.5", "ContextLength": 200000, "SupportsEffort": false, "Capabilities": [ "completion", "tools" ] }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "pretty-json",
      "FormatterOptions": {
        "TimestampFormat": "[yyyy-MM-dd HH:mm:ss] "
      }
    },
    "File": {
      "BasePath": "Logs",
      "FileAccessMode": "KeepOpenAndAutoFlush",
      "FileEncodingName": "utf-8",
      "DateFormat": "yyyyMMdd",
      "CounterFormat": "000",
      "MaxFileSize": 10485760,
      "TextBuilderType": "ClaudeCodeOllamaProxy.Service.Logging.CustomLogFormatTextBuilder, ClaudeCodeOllamaProxy.Core",
      "Files": [
        {
          "Path": "<appname>-<date>-<launch>-<counter>.log",
          "MinLevel": { "Default": "Trace" }
        }
      ]
    }
  },
  "AllowedHosts": "*",
  "Wire": {
    "MaxBytes": 1048576
  }
}
