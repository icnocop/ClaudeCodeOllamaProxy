<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClaudeCodeOllamaProxy.UI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <!-- Header row: title on the left, "Reset to default settings" on the right. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Settings" Style="{ThemeResource TitleTextBlockStyle}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="ResetButton" Click="ResetButton_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE777;" FontSize="14" />
                        <TextBlock Text="Reset to default settings" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Run at startup -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE7E8;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Run at startup" />
                        <TextBlock Text="Start Claude Code Ollama Proxy automatically when you sign in."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartupToggle" Grid.Column="2"
                                  Toggled="StartupToggle_Toggled" />
                </Grid>
            </Border>

            <!-- Minimize to tray on close -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE7B3;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Minimize to system tray on close" />
                        <TextBlock Text="When on, closing the window hides it and the proxy keeps running in the tray. When off, closing quits the app."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="MinimizeToTrayToggle" Grid.Column="2"
                                  Toggled="MinimizeToTrayToggle_Toggled" />
                </Grid>
            </Border>

            <!-- Start minimized to tray -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE921;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Start minimized to tray" />
                        <TextBlock Text="When on, the app starts hidden in the system tray with no window. The proxy still runs; open the window from the tray icon."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartMinimizedToggle" Grid.Column="2"
                                  Toggled="StartMinimizedToggle_Toggled" />
                </Grid>
            </Border>

            <!-- Check for updates at startup -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE895;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Automatically check for updates when the app starts" />
                        <TextBlock Text="Ask GitHub for a newer release on each launch. Nothing is downloaded or installed; you can also check any time from the About tab."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="UpdateCheckToggle" Grid.Column="2"
                                  Toggled="UpdateCheckToggle_Toggled" />
                </Grid>
            </Border>

            <!-- Include pre-release versions -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xEBD2;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Include pre-release versions" />
                        <TextBlock Text="Offer pre-release builds as updates too. Applies to both the startup check and the About tab's button."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="PrereleaseToggle" Grid.Column="2"
                                  Toggled="PrereleaseToggle_Toggled" />
                </Grid>
            </Border>

            <!-- Run as administrator -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7EF;" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Run as administrator" />
                            <TextBlock Text="Always start elevated. The Claude CLI the proxy launches also runs as administrator."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AdminToggle" Grid.Column="2"
                                      Toggled="AdminToggle_Toggled" />
                    </Grid>
                    <Button x:Name="RestartAdminButton" Click="RestartAdminButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7EF;" FontSize="14" />
                            <TextBlock Text="Restart as administrator" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="AdminStatusText" Text="The app is currently running as administrator."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- App theme -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE771;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="App theme" />
                        <TextBlock Text="Choose how the app follows light or dark mode."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeCombo" Grid.Column="2" VerticalAlignment="Center"
                              SelectionChanged="ThemeCombo_SelectionChanged" MinWidth="160">
                        <ComboBoxItem Content="System default" Tag="System" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Window size -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE73F;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Window size and position" />
                        <TextBlock Text="Reset the main window to its default size and re-center it on screen. The navigation pane stays as it is."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="ResetWindowSizeButton" Grid.Column="2" VerticalAlignment="Center"
                            Content="Reset size and center" Click="ResetWindowSizeButton_Click" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
